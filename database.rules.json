{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('admins').hasChild(auth.uid))"
      }
    },

    "usernames": {
      "$name": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && data.val() === auth.uid))"
      }
    },

    "presence": {
      "$categoryId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "chatRequests": {
      "$requestId": {
        ".read": "auth != null && (data.child('fromUid').val() === auth.uid || data.child('toUid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('admins').hasChild(auth.uid))",
        ".write": "auth != null && ((!data.exists() && newData.child('fromUid').val() === auth.uid) || (data.exists() && (data.child('fromUid').val() === auth.uid || data.child('toUid').val() === auth.uid)) || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('admins').hasChild(auth.uid))"
      }
    },

    "conversations": {
      "$conversationId": {
        ".read": "auth != null && (data.child('participants').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('admins').hasChild(auth.uid))",
        ".write": "auth != null && (!data.exists() || data.child('participants').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('admins').hasChild(auth.uid))"
      }
    },

    "messages": {
      "$conversationId": {
        ".read": "auth != null && (root.child('conversations').child($conversationId).child('participants').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('admins').hasChild(auth.uid))",
        "$messageId": {
          ".write": "auth != null && ((root.child('conversations').child($conversationId).child('participants').child(auth.uid).val() === true && newData.child('senderId').val() === auth.uid) || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('admins').hasChild(auth.uid))"
        }
      }
    },

    "voiceMessages": {
      "$conversationId": {
        ".read": "auth != null && (root.child('conversations').child($conversationId).child('participants').child(auth.uid).val() === true || root.child('admins').hasChild(auth.uid))",
        "$messageId": {
          ".write": "auth != null && ((root.child('conversations').child($conversationId).child('participants').child(auth.uid).val() === true && newData.child('senderId').val() === auth.uid) || root.child('admins').hasChild(auth.uid))"
        }
      }
    },

    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "reports": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('admins').hasChild(auth.uid))",
      "$reportId": {
        ".write": "auth != null && ((!data.exists() && (newData.child('reporterId').val() === auth.uid || newData.child('reporterUid').val() === auth.uid)) || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('admins').hasChild(auth.uid))"
      }
    },

    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'super_admin')"
      }
    },

    "app_settings": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'super_admin')"
    },

    "ads": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).child('role').val() === 'super_admin' || root.child('admins').child(auth.uid).child('role').val() === 'ad_manager' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'super_admin')"
    },

    "ads_config": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'super_admin')"
    },

    "audit_logs": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('admins').hasChild(auth.uid))",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('admins').hasChild(auth.uid))"
    }
  }
}
