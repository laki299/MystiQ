{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('admins').hasChild(auth.uid))"
      }
    },

    "usernames": {
      "$name": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && data.val() === auth.uid))"
      }
    },

    "presence": {
      "$categoryId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "chatRequests": {
      "$requestId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "conversations": {
      "$conversationId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "messages": {
      "$conversationId": {
        ".read": "auth != null",
        "$messageId": {
          ".write": "auth != null && (!newData.exists() || newData.child('senderId').val() === auth.uid || newData.child('senderUid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('admins').hasChild(auth.uid))"
        }
      }
    },

    "voiceMessages": {
      "$conversationId": {
        ".read": "auth != null",
        "$messageId": {
          ".write": "auth != null && (!newData.exists() || newData.child('senderId').val() === auth.uid || root.child('admins').hasChild(auth.uid))"
        }
      }
    },

    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "reports": {
      ".read": "auth != null",
      "$reportId": {
        ".write": "auth != null"
      }
    },

    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null"
      }
    },

    "app_settings": {
      ".read": true,
      ".write": "auth != null"
    },

    "ads": {
      ".read": true,
      ".write": "auth != null"
    },

    "ads_config": {
      ".read": true,
      ".write": "auth != null"
    },

    "audit_logs": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
